# RViz2 configuration for SELENE — FR-MAP-4.
#
# FIXED FRAME IS LOAD-BEARING. Nothing in this repository publishes TF:
# /tf and /tf_static have zero publishers at runtime, no node constructs a
# TransformBroadcaster, and no launch file bridges them out of Gazebo. RViz2
# can still transform a message whose header.frame_id is IDENTICAL to the
# fixed frame, via tf2's same-frame identity shortcut — so displays work, but
# only for that one frame string.
#
# Hence "Fixed Frame: map", matching resource_map_frame_id in
# selene_orchestrator/config/orchestrator_params.yaml and the frame_id the
# navigator already stamps on its nav_msgs/Path
# (selene_agent/selene_agent/navigator.py:679). This file previously said
# `odom`, which no publisher ever used, so the Path would not have rendered
# either. Change one of those three and you must change all three.
#
# Expect "Global Status: Warn" on the TF row while the TF tree is empty — that
# is the tree reporting it cannot find `map` as a broadcast frame. The overlay
# still renders.
Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /Resource Map1
      Splitter Ratio: 0.5
    Tree Height: 640
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Alpha: 0.5
      Cell Size: 10
      Color: 160; 160; 164
      Line Style:
        Line Width: 0.03
        Value: Lines
      Normal Cell Count: 0
      Plane: XY
      Plane Cell Count: 50
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 5
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true
    # FR-MAP-4. One CUBE_LIST marker carrying per-cell ColorRGBA: hue encodes
    # ice concentration (clause b), alpha encodes certainty (clause c).
    #
    # Namespaces is left empty on purpose. RViz2 populates it from the incoming
    # marker's ns and enables it by default; pinning a stale name here is how a
    # display ends up correctly subscribed and still invisible.
    - Class: rviz_default_plugins/MarkerArray
      Name: Resource Map
      Enabled: true
      Namespaces:
        {}
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /orchestrator/resource_map_markers
      Value: true
  Enabled: true
  Global Options:
    Background Color: 10; 10; 10
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Value: true
  Views:
    Current:
      # Framed on the PSR at (-100,-150), where the four deposits in
      # selene_sim/config/ice_deposits.yaml sit, so the overlay is in shot at
      # startup rather than behind the camera.
      Class: rviz_default_plugins/Orbit
      Distance: 260
      Focal Point:
        X: -100
        Y: -150
        Z: 0
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.2
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.785398
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Views:
    collapsed: false
  Width: 1600
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true

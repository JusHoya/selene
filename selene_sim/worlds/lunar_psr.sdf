<?xml version="1.0"?>
<sdf version="1.9">
  <world name="lunar_psr">

    <!-- Lunar gravity: 1.62 m/s^2.
         MUST be a direct child of <world>. SDF 1.9 defines <gravity> at world
         scope only; a <gravity> nested inside <physics> is ignored, which
         silently left this world running at Earth gravity.
         NOW VALIDATED in Gazebo Harmonic (gz-sim 8.11.0): with this element at
         world scope a scout spawned on the real terrain at its configured pose
         drives 4.6958 m in 12 s against 4.6740 m of odometry (0.5% slip), and a
         hauler 4.4197 m against 4.6065 m (4.1% slip). Lunar gravity is not
         marginal for these vehicles - see scripts/check_drive.sh. -->
    <gravity>0 0 -1.62</gravity>

    <!-- Physics: step size / real-time settings.
         type="ode" is a NO-OP and is kept only because removing it would be a
         behaviour-free churn: MEASURED - there is no ODE engine plugin installed
         (only dartsim, bullet, bullet-featherstone and tpe under
         gz-physics-7/engine-plugins), and the server log reports
         "Loaded [gz::physics::dartsim::Plugin]". Every <surface><friction><ode>
         block in this project's models is still read by sdformat's generic
         mapping and honoured by dartsim; the "ode" label is not.
         Do NOT set <real_time_update_rate>0</real_time_update_rate> here
         expecting "as fast as possible": in gz-sim Harmonic that throttles the
         server to ~0.03x real time. Use <real_time_factor>0</real_time_factor>. -->
    <physics name="lunar_physics" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <!-- Gazebo Harmonic system plugins -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu">
    </plugin>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact">
    </plugin>

    <!-- Scene: Dark lunar environment -->
    <scene>
      <ambient>0.02 0.02 0.02 1</ambient>
      <background>0 0 0 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Sun: Low-angle directional light simulating polar illumination -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>1.0 0.98 0.95 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>0.3 -0.1 -0.15</direction>
    </light>

    <!-- Lunar terrain -->
    <include>
      <uri>model://lunar_terrain</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- ISRU PROCESSING DEPOT, ON THE CRATER FLOOR. Moved here from (-30,-100)
         on 2026-07-31, and the reason is a measurement rather than a taste.

         THE PSR CRATER IS A ONE-WAY TRIP. generate_heightmap.py carves it at
         (-100,-150) with diameter 120, depth 15 and flat_fraction 0.25, so the
         15 m of relief is spread over the 45 m annulus between r=15 and r=60
         and the parabolic profile puts its steepest part AT THE RIM. Evaluating
         the shipped field (seed 42) radially from the crater centre on 24
         azimuths at 15 deg spacing, the maximum uphill gradient over a 3 m
         baseline is 34.3-39.2 deg on EVERY ONE of them; the gentlest way out is
         34.3 deg at azimuth 135. That is not a slope these vehicles climb, and
         it is not a slope any profile could fix at this diameter: 15 m over a
         45 m run is 18.4 deg on average whatever shape you give it.
         selene_sim/test/test_mission_traversability.py recomputes those numbers
         from the generator on every run so this comment cannot rot.

         WHAT THAT DID. Every ice deposit in ice_deposits.yaml is inside the
         crater (r = 20.6-22.4 m from its centre) and both previous depot
         positions were outside it, so EVERY HAUL had to cross that wall. On
         2026-07-31 a hauler tried: it climbed to r=57.5 m, pitched over to
         -35 deg and pinned, and for 320.7 s its wheels turned at the commanded
         0.395 m/s while its body moved 6.6 cm. Its dead-reckoned pose sailed on
         to within 0.4 m of the configured depot and it unloaded 19 kg there,
         241.577 m from where it actually was. (Figures from that run's
         analyser; not re-measured here.)

         SO THE DEPOT IS WHERE THE MISSION CAN REACH IT. On the flat crater
         floor, central to all four deposits (20.3-22.4 m from each), which is
         also a defensible ISRU architecture: process the regolith where it is
         and ship the product out later. What it does NOT solve is the return
         leg - the recharge pad below is still outside the crater and still
         behind that wall. Recorded, not hidden: see docs/phase5_deviation_register.md.

         The marker is STATIC, so unlike a robot it never settles - whatever z is
         written here is where it stays, and it must be placed by measurement.
         MEASURED collision surface at (-100,-150) = -13.914932 m (2026-07-30,
         gz-sim 8.14.0, scripts/check_terrain.sh, probe sphere pinned to a
         prismatic Z-only joint so it cannot roll off the sample point; the
         number is recorded in selene_sim/config/spawn_positions.yaml beside the
         four spawn surfaces measured in the same run).
         The marker is a cylinder of radius 1.0 and length 0.1, so its centre
         must sit at surface + 0.05 to rest on the ground:
         -13.914932 + 0.05 = -13.864932, rounded UP to -13.86 so the disc's
         underside clears the ground rather than grazing it.
         If you regenerate the heightmap, re-run scripts/check_terrain.sh and
         reset this from its reported surface_z for the depot row. -->
    <include>
      <uri>model://depot_marker</uri>
      <name>depot</name>
      <pose>-100 -150 -13.86 0 0 0</pose>
    </include>

    <!-- RECHARGE PAD, on the illuminated plain outside the PSR. This is the
         coordinate the depot marker used to occupy, and it keeps its surveyed
         height: MEASURED collision surface at (-30,-100) = +0.886175 m, so a
         0.1 m disc rests with its centre at 0.886175 + 0.05 = 0.936, rounded UP
         to 0.94. Same gate, same run as the depot above.
         It is a marker only. Nothing in the code reads it; the recharge
         position lives in world_params.yaml and selene_agent's parameters, and
         those three coordinates do not all agree (see world_params.yaml). What
         this does buy is that the place the fleet is told to recharge at is now
         a place with something visible on it, which is one more than before. -->
    <include>
      <uri>model://depot_marker</uri>
      <name>recharge_pad</name>
      <pose>-30 -100 0.94 0 0 0</pose>
    </include>

    <!-- ============================================================ -->
    <!-- ROCKS: PSR crater rim cluster (around -100, -150, radius ~60m) -->
    <!-- ============================================================ -->

    <!-- EVERY ROCK z BELOW IS SURVEYED. Do not hand-edit one, and never set a
         constant.
         All 26 used to sit at z=0 while the collision surface ranged from
         -6.54 m to +7.64 m across their coordinates. They are <static>true</static>,
         so unlike a robot they neither fall onto the ground nor get extruded out
         of it: they simply sat inside the terrain, contributing buried collision
         geometry and an invisible mesh - or, for the 10 inside the 60 m PSR
         radius, floated up to 14 m ABOVE the crater floor.

         z = (collision surface measured at that XY) + (distance from the model
         origin down to the lowest point of its collision box), rounded UP to
         10 mm so a rock is never left part-buried by rounding.

         THE SECOND TERM IS PER-ROCK, NOT PER-MODEL. Both rock models are BOXES
         whose collision carries its own roll/pitch (crater_rock_01: 0.3/0.2 on a
         0.5x0.3x0.4 box; crater_rock_02: 0.25/0.15 on 1.2x0.8x0.6), and each
         <include> below adds another roll/pitch. The composed rotation
         R_include * R_collision determines the lowest corner:
             drop = |R[2][0]|*hx + |R[2][1]|*hy + |R[2][2]|*hz
         Yaw drops out - a rotation about world Z cannot change a z extent. The
         computed drops span 0.287-0.330 m for crater_rock_01 and 0.504-0.612 m
         for crater_rock_02, so using one number per model would under-seat
         several rocks by 5-14 cm. If it were a sphere none of this would matter;
         it is not.

         Surfaces measured 2026-07-30 (gz-sim 8.14.0) by adding these 26
         coordinates to the POINTS list in scripts/check_terrain.sh as SURVEY
         points and reading the surface_z column - 40 probes, and the run still
         took 48 s because the settle is a fixed sleep. To redo it after a terrain
         change, repeat exactly that.

         KNOWN LIMITATION: the gate is not asserting these. A rock's z is its
         model ORIGIN, and the collision hangs up to 0.61 m BELOW that, but
         check_terrain.sh's clearance test only compares placed_z against the
         surface - it knows nothing about per-entity geometry. Adding the rocks as
         PLACED points would therefore pass on a rock buried by less than its own
         drop. They are left as survey coordinates, which does assert that
         collision geometry exists at each. The depot marker has the same
         shape of gap, bounded by its 0.05 m half-height. -->


    <!-- Crater rim rocks: small rocks (crater_rock_01) -->
    <include>
      <uri>model://crater_rock_01</uri>
      <name>crater_rim_rock_01</name>
      <pose>-55 -110 3.6 0.1 0.0 0.8</pose>
    </include>

    <include>
      <uri>model://crater_rock_01</uri>
      <name>crater_rim_rock_02</name>
      <pose>-72 -98 2.27 0.0 0.2 1.5</pose>
    </include>

    <include>
      <uri>model://crater_rock_01</uri>
      <name>crater_rim_rock_03</name>
      <pose>-140 -120 -3.09 0.3 0.1 2.3</pose>
    </include>

    <include>
      <uri>model://crater_rock_01</uri>
      <name>crater_rim_rock_04</name>
      <pose>-125 -195 -1.57 0.15 0.25 0.4</pose>
    </include>

    <include>
      <uri>model://crater_rock_01</uri>
      <name>crater_rim_rock_05</name>
      <pose>-60 -175 -6.24 0.2 0.0 3.1</pose>
    </include>

    <include>
      <uri>model://crater_rock_01</uri>
      <name>crater_rim_rock_06</name>
      <pose>-88 -92 1.23 0.0 0.3 1.9</pose>
    </include>

    <!-- Crater rim rocks: large rocks (crater_rock_02) -->
    <include>
      <uri>model://crater_rock_02</uri>
      <name>crater_rim_rock_07</name>
      <pose>-48 -145 -2.43 0.1 0.15 0.6</pose>
    </include>

    <include>
      <uri>model://crater_rock_02</uri>
      <name>crater_rim_rock_08</name>
      <pose>-150 -155 -1.59 0.2 0.0 2.7</pose>
    </include>

    <include>
      <uri>model://crater_rock_02</uri>
      <name>crater_rim_rock_09</name>
      <pose>-105 -205 1.49 0.05 0.2 1.1</pose>
    </include>

    <include>
      <uri>model://crater_rock_02</uri>
      <name>crater_rim_rock_10</name>
      <pose>-95 -95 -0.75 0.15 0.1 3.5</pose>
    </include>

    <include>
      <uri>model://crater_rock_02</uri>
      <name>crater_rim_rock_11</name>
      <pose>-68 -190 -2.77 0.0 0.25 0.2</pose>
    </include>

    <!-- ============================================================ -->
    <!-- ROCKS: General terrain scatter -->
    <!-- ============================================================ -->

    <include>
      <uri>model://crater_rock_01</uri>
      <name>terrain_rock_01</name>
      <pose>30 -20 0.49 0.2 0.1 0.5</pose>
    </include>

    <include>
      <uri>model://crater_rock_01</uri>
      <name>terrain_rock_02</name>
      <pose>-180 60 1.51 0.0 0.3 1.8</pose>
    </include>

    <include>
      <uri>model://crater_rock_01</uri>
      <name>terrain_rock_03</name>
      <pose>120 -80 0.65 0.25 0.0 2.9</pose>
    </include>

    <include>
      <uri>model://crater_rock_01</uri>
      <name>terrain_rock_04</name>
      <pose>-40 100 -0.4 0.1 0.15 0.1</pose>
    </include>

    <include>
      <uri>model://crater_rock_01</uri>
      <name>terrain_rock_05</name>
      <pose>80 130 0.63 0.3 0.2 3.7</pose>
    </include>

    <include>
      <uri>model://crater_rock_02</uri>
      <name>terrain_rock_06</name>
      <pose>-150 -30 0.06 0.1 0.0 1.2</pose>
    </include>

    <include>
      <uri>model://crater_rock_02</uri>
      <name>terrain_rock_07</name>
      <pose>160 50 0.86 0.0 0.2 2.4</pose>
    </include>

    <include>
      <uri>model://crater_rock_02</uri>
      <name>terrain_rock_08</name>
      <pose>-20 -200 0.8 0.2 0.1 0.7</pose>
    </include>

    <include>
      <uri>model://crater_rock_01</uri>
      <name>terrain_rock_09</name>
      <pose>100 -150 -0.47 0.15 0.05 4.0</pose>
    </include>

    <include>
      <uri>model://crater_rock_02</uri>
      <name>terrain_rock_10</name>
      <pose>-90 180 0.03 0.0 0.3 1.6</pose>
    </include>

    <include>
      <uri>model://crater_rock_01</uri>
      <name>terrain_rock_11</name>
      <pose>200 -100 7.94 0.2 0.0 2.1</pose>
    </include>

    <!-- ============================================================ -->
    <!-- ROCKS: Chokepoint clusters (larger rocks blocking paths) -->
    <!-- ============================================================ -->

    <!-- Chokepoint between depot and PSR crater -->
    <include>
      <uri>model://crater_rock_02</uri>
      <name>chokepoint_rock_01</name>
      <pose>-10 -40 1.1 0.1 0.2 0.9</pose>
    </include>

    <include>
      <uri>model://crater_rock_02</uri>
      <name>chokepoint_rock_02</name>
      <pose>-15 -45 1.02 0.2 0.0 2.0</pose>
    </include>

    <!-- Chokepoint on eastern approach -->
    <include>
      <uri>model://crater_rock_02</uri>
      <name>chokepoint_rock_03</name>
      <pose>180 -50 3.69 0.0 0.15 1.4</pose>
    </include>

    <!-- Chokepoint near northern edge -->
    <include>
      <uri>model://crater_rock_02</uri>
      <name>chokepoint_rock_04</name>
      <pose>-50 200 0.45 0.25 0.1 3.2</pose>
    </include>

  </world>
</sdf>

<?xml version="1.0"?>
<sdf version="1.9">
  <world name="lunar_psr">

    <!-- Lunar gravity: 1.62 m/s^2.
         MUST be a direct child of <world>. SDF 1.9 defines <gravity> at world
         scope only; a <gravity> nested inside <physics> is ignored, which
         silently left this world running at Earth gravity.
         NOW VALIDATED in Gazebo Harmonic (gz-sim 8.11.0): with this element at
         world scope a scout spawned on the real terrain at its configured pose
         drives 4.6958 m in 12 s against 4.6740 m of odometry (0.5% slip), and a
         hauler 4.4197 m against 4.6065 m (4.1% slip). Lunar gravity is not
         marginal for these vehicles - see scripts/check_drive.sh. -->
    <gravity>0 0 -1.62</gravity>

    <!-- Physics: step size / real-time settings.
         type="ode" is a NO-OP and is kept only because removing it would be a
         behaviour-free churn: MEASURED - there is no ODE engine plugin installed
         (only dartsim, bullet, bullet-featherstone and tpe under
         gz-physics-7/engine-plugins), and the server log reports
         "Loaded [gz::physics::dartsim::Plugin]". Every <surface><friction><ode>
         block in this project's models is still read by sdformat's generic
         mapping and honoured by dartsim; the "ode" label is not.
         Do NOT set <real_time_update_rate>0</real_time_update_rate> here
         expecting "as fast as possible": in gz-sim Harmonic that throttles the
         server to ~0.03x real time. Use <real_time_factor>0</real_time_factor>. -->
    <physics name="lunar_physics" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <!-- Gazebo Harmonic system plugins -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu">
    </plugin>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact">
    </plugin>

    <!-- Scene: Dark lunar environment -->
    <scene>
      <ambient>0.02 0.02 0.02 1</ambient>
      <background>0 0 0 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Sun: Low-angle directional light simulating polar illumination -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>1.0 0.98 0.95 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>0.3 -0.1 -0.15</direction>
    </light>

    <!-- Lunar terrain -->
    <include>
      <uri>model://lunar_terrain</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Processing depot marker.
         The marker is STATIC, so unlike a robot it never settles - whatever z is
         written here is where it stays, and it must be placed by measurement.
         MEASURED collision surface at (-30,-100) = +0.886175 m (2026-07-30,
         gz-sim 8.14.0, scripts/check_terrain.sh, probe sphere pinned to a
         prismatic Z-only joint so it cannot roll off the sample point).
         The marker is a cylinder of radius 1.0 and length 0.1, so its centre
         must sit at surface + 0.05 to rest on the ground:
         0.886175 + 0.05 = 0.936, rounded UP to 0.94 so the disc's underside
         clears the ground rather than grazing it.
         This moved down from 1.86 because the heightmap normalisation bug was
         fixed - the terrain itself is ~0.92 m lower here now. See
         selene_sim/scripts/generate_heightmap.py and the note on terrain_link in
         models/lunar_terrain/model.sdf. Before that fix, z=1.5 put the disc's
         TOP 0.26 m BELOW the surface: the depot was entirely inside the terrain
         and invisible.
         If you regenerate the heightmap, re-run scripts/check_terrain.sh and
         reset this from its reported surface_z for the depot row. -->
    <include>
      <uri>model://depot_marker</uri>
      <name>depot</name>
      <pose>-30 -100 0.94 0 0 0</pose>
    </include>

    <!-- ============================================================ -->
    <!-- ROCKS: PSR crater rim cluster (around -100, -150, radius ~60m) -->
    <!-- ============================================================ -->

    <!-- KNOWN DEFECT, NOT FIXED HERE: every one of the 26 rocks below is placed
         at z=0, and the collision surface is nowhere near 0. They are all
         <static>true</static>, so unlike a robot they do not fall onto the
         ground and they are not extruded out of it - they simply sit inside the
         terrain, contributing collision geometry that is mostly or entirely
         buried and a mesh that is mostly or entirely invisible.
         MEASURED depth of burial at the surrounding surface heights: on the
         plain the surface is +0.29 to +1.45 m, so the plain rocks are buried by
         roughly that much; inside the PSR the surface is about -13.9 m, so those
         rocks float ~14 m ABOVE the crater floor.
         This predates the datum fix and is not caused by it - the fix made it
         strictly less bad on the plain (the surface there dropped ~0.9 m) and
         did not change its nature. It is left alone because correcting it
         honestly means measuring the collision surface at all 26 coordinates and
         deciding each rock model's origin-to-underside offset, which is a
         separate change with its own gate work. Do not "fix" it by guessing a
         constant z.
         To fix it: add these 26 XY pairs to the POINTS list in
         scripts/check_terrain.sh as placed coordinates, run it, and set each
         pose z from the reported surface_z plus that model's half-height. The
         gate already fails on a buried PLACED coordinate, so it will confirm the
         result. -->


    <!-- Crater rim rocks: small rocks (crater_rock_01) -->
    <include>
      <uri>model://crater_rock_01</uri>
      <name>crater_rim_rock_01</name>
      <pose>-55 -110 0 0.1 0.0 0.8</pose>
    </include>

    <include>
      <uri>model://crater_rock_01</uri>
      <name>crater_rim_rock_02</name>
      <pose>-72 -98 0 0.0 0.2 1.5</pose>
    </include>

    <include>
      <uri>model://crater_rock_01</uri>
      <name>crater_rim_rock_03</name>
      <pose>-140 -120 0 0.3 0.1 2.3</pose>
    </include>

    <include>
      <uri>model://crater_rock_01</uri>
      <name>crater_rim_rock_04</name>
      <pose>-125 -195 0 0.15 0.25 0.4</pose>
    </include>

    <include>
      <uri>model://crater_rock_01</uri>
      <name>crater_rim_rock_05</name>
      <pose>-60 -175 0 0.2 0.0 3.1</pose>
    </include>

    <include>
      <uri>model://crater_rock_01</uri>
      <name>crater_rim_rock_06</name>
      <pose>-88 -92 0 0.0 0.3 1.9</pose>
    </include>

    <!-- Crater rim rocks: large rocks (crater_rock_02) -->
    <include>
      <uri>model://crater_rock_02</uri>
      <name>crater_rim_rock_07</name>
      <pose>-48 -145 0 0.1 0.15 0.6</pose>
    </include>

    <include>
      <uri>model://crater_rock_02</uri>
      <name>crater_rim_rock_08</name>
      <pose>-150 -155 0 0.2 0.0 2.7</pose>
    </include>

    <include>
      <uri>model://crater_rock_02</uri>
      <name>crater_rim_rock_09</name>
      <pose>-105 -205 0 0.05 0.2 1.1</pose>
    </include>

    <include>
      <uri>model://crater_rock_02</uri>
      <name>crater_rim_rock_10</name>
      <pose>-95 -95 0 0.15 0.1 3.5</pose>
    </include>

    <include>
      <uri>model://crater_rock_02</uri>
      <name>crater_rim_rock_11</name>
      <pose>-68 -190 0 0.0 0.25 0.2</pose>
    </include>

    <!-- ============================================================ -->
    <!-- ROCKS: General terrain scatter -->
    <!-- ============================================================ -->

    <include>
      <uri>model://crater_rock_01</uri>
      <name>terrain_rock_01</name>
      <pose>30 -20 0 0.2 0.1 0.5</pose>
    </include>

    <include>
      <uri>model://crater_rock_01</uri>
      <name>terrain_rock_02</name>
      <pose>-180 60 0 0.0 0.3 1.8</pose>
    </include>

    <include>
      <uri>model://crater_rock_01</uri>
      <name>terrain_rock_03</name>
      <pose>120 -80 0 0.25 0.0 2.9</pose>
    </include>

    <include>
      <uri>model://crater_rock_01</uri>
      <name>terrain_rock_04</name>
      <pose>-40 100 0 0.1 0.15 0.1</pose>
    </include>

    <include>
      <uri>model://crater_rock_01</uri>
      <name>terrain_rock_05</name>
      <pose>80 130 0 0.3 0.2 3.7</pose>
    </include>

    <include>
      <uri>model://crater_rock_02</uri>
      <name>terrain_rock_06</name>
      <pose>-150 -30 0 0.1 0.0 1.2</pose>
    </include>

    <include>
      <uri>model://crater_rock_02</uri>
      <name>terrain_rock_07</name>
      <pose>160 50 0 0.0 0.2 2.4</pose>
    </include>

    <include>
      <uri>model://crater_rock_02</uri>
      <name>terrain_rock_08</name>
      <pose>-20 -200 0 0.2 0.1 0.7</pose>
    </include>

    <include>
      <uri>model://crater_rock_01</uri>
      <name>terrain_rock_09</name>
      <pose>100 -150 0 0.15 0.05 4.0</pose>
    </include>

    <include>
      <uri>model://crater_rock_02</uri>
      <name>terrain_rock_10</name>
      <pose>-90 180 0 0.0 0.3 1.6</pose>
    </include>

    <include>
      <uri>model://crater_rock_01</uri>
      <name>terrain_rock_11</name>
      <pose>200 -100 0 0.2 0.0 2.1</pose>
    </include>

    <!-- ============================================================ -->
    <!-- ROCKS: Chokepoint clusters (larger rocks blocking paths) -->
    <!-- ============================================================ -->

    <!-- Chokepoint between depot and PSR crater -->
    <include>
      <uri>model://crater_rock_02</uri>
      <name>chokepoint_rock_01</name>
      <pose>-10 -40 0 0.1 0.2 0.9</pose>
    </include>

    <include>
      <uri>model://crater_rock_02</uri>
      <name>chokepoint_rock_02</name>
      <pose>-15 -45 0 0.2 0.0 2.0</pose>
    </include>

    <!-- Chokepoint on eastern approach -->
    <include>
      <uri>model://crater_rock_02</uri>
      <name>chokepoint_rock_03</name>
      <pose>180 -50 0 0.0 0.15 1.4</pose>
    </include>

    <!-- Chokepoint near northern edge -->
    <include>
      <uri>model://crater_rock_02</uri>
      <name>chokepoint_rock_04</name>
      <pose>-50 200 0 0.25 0.1 3.2</pose>
    </include>

  </world>
</sdf>

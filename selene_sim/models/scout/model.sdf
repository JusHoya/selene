<?xml version="1.0"?>
<sdf version="1.9">
  <model name="scout">

    <!-- Base chassis -->
    <link name="base_link">
      <pose>0 0 0.12 0 0 0</pose>
      <inertial>
        <mass>44</mass>
        <inertia>
          <ixx>0.66917</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.40250</iyy>
          <iyz>0</iyz>
          <izz>1.90667</izz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.6 0.4 0.15</size>
          </box>
        </geometry>
      </collision>
      <visual name="base_visual">
        <geometry>
          <box>
            <size>0.6 0.4 0.15</size>
          </box>
        </geometry>
        <material>
          <ambient>0.7 0.7 0.7 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
        </material>
      </visual>

      <!-- IMU sensor -->
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>imu</topic>
      </sensor>

      <!-- Depth camera -->
      <sensor name="depth_camera_sensor" type="depth_camera">
        <pose relative_to="base_link">0.3 0 0.05 0 0 0</pose>
        <update_rate>15</update_rate>
        <topic>depth_camera</topic>
        <camera>
          <horizontal_fov>1.5708</horizontal_fov>
          <image>
            <width>160</width>
            <height>120</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>20.0</far>
          </clip>
        </camera>
      </sensor>
    </link>

    <!-- Front left wheel -->
    <!-- GROUND CLEARANCE. The wheels sit 0.06 m BELOW base_link, not level with
         it. base_link is at z=0.12 with a 0.15 m-tall chassis, so the chassis
         bottom is at 0.045 m; wheels of radius 0.1 at the same height as
         base_link would put the wheel bottom at 0.02 m, leaving 25 mm of
         clearance. Dropping the wheels 0.06 m puts the wheel bottom 0.04 m BELOW
         the model origin and gives ~85 mm of clearance. wheel_separation (0.5)
         and wheel_radius (0.1) are unchanged, so DiffDrive kinematics are
         unaffected. Consequence used by everything downstream: a settled scout's
         model origin sits at (local surface height + 0.04 m). The 0.04 m is
         geometric, not fitted: wheel pose z -0.06 under base_link at 0.12 with
         radius 0.1. MEASURED twice, on two different terrains, which is why it is
         quoted as a property rather than as a number:
             old datum  settled 2.532000 vs surveyed 2.4925    -> +0.0395
             new datum  settled 1.485330 vs surveyed 1.446014  -> +0.0393
         (The terrain moved ~1.05 m down between those two when the heightmap
         normalisation bug was fixed - see selene_sim/scripts/generate_heightmap.py
         - and the offset did not move, to 0.2 mm.)

         CORRECTION - the previous version of this comment claimed the 25 mm
         clearance was the MEASURED cause of "the chassis grounded out, the wheels
         spun free, 100% slip on the real lunar terrain". That is wrong and the
         clearance change never fixed anything. The 100% slip had nothing to do
         with clearance: the robot was spawned ~1.0 m BELOW the terrain collision
         surface and was entombed in the heightfield. Evidence: raising ONLY the
         spawn z from 1.5 to 2.8, with this model byte-identical, took world
         displacement from 0.0000 m to 4.6958 m in the same 12 s at 0.4 m/s; and
         the symptom was insensitive to clearance precisely because 60 mm of
         clearance cannot matter against 1000 mm of burial. See
         selene_sim/config/spawn_positions.yaml for the survey and the numbers,
         and scripts/check_drive.sh for the gate that now catches it.
         The extra clearance is kept anyway - it is measured-good and gives the
         chassis room on the 3.91 m collision-heightmap cells - but it is not a
         fix for anything. -->
    <link name="front_left_wheel">
      <pose relative_to="base_link">0.22 0.25 -0.06 -1.5708 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.00406</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00406</iyy>
          <iyz>0</iyz>
          <izz>0.0075</izz>
        </inertia>
      </inertial>
      <collision name="front_left_wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.6</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="front_left_wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <!-- Front right wheel -->
    <link name="front_right_wheel">
      <pose relative_to="base_link">0.22 -0.25 -0.06 -1.5708 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.00406</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00406</iyy>
          <iyz>0</iyz>
          <izz>0.0075</izz>
        </inertia>
      </inertial>
      <collision name="front_right_wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.6</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="front_right_wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <!-- Rear left wheel -->
    <link name="rear_left_wheel">
      <pose relative_to="base_link">-0.22 0.25 -0.06 -1.5708 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.00406</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00406</iyy>
          <iyz>0</iyz>
          <izz>0.0075</izz>
        </inertia>
      </inertial>
      <collision name="rear_left_wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.6</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="rear_left_wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <!-- Rear right wheel -->
    <link name="rear_right_wheel">
      <pose relative_to="base_link">-0.22 -0.25 -0.06 -1.5708 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.00406</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00406</iyy>
          <iyz>0</iyz>
          <izz>0.0075</izz>
        </inertia>
      </inertial>
      <collision name="rear_right_wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.6</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="rear_right_wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <!-- DiffDrive plugin -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.5</wheel_separation>
      <wheel_radius>0.1</wheel_radius>
      <max_linear_acceleration>0.5</max_linear_acceleration>
      <odom_publish_frequency>20</odom_publish_frequency>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <!-- Intended as a dead-man switch: zero the wheels if no cmd_vel arrives
           for 0.5 s. MEASURED: IT DOES NOTHING on the installed Gazebo. The
           string "cmd_timeout" does not occur in either installed DiffDrive
           build - `strings ... | grep -cx cmd_timeout` returns 0 for both
           /opt/ros/jazzy/opt/gz_sim_vendor/lib/gz-sim-8/plugins/libgz-sim8-diff-drive-system.so.8.11.0
           and /usr/lib/x86_64-linux-gnu/gz-sim-8/plugins/libgz-sim8-diff-drive-system.so.8.14.0
           (the same check returns 1 for "max_linear_acceleration", which the
           plugin does implement). gz-sim ignores unrecognised plugin elements
           silently, with no warning even at -v 4, so nothing flags this.
           There is therefore NO dead-man switch in the simulation: the only stop
           is the software one in AgentNode._stop_navigation(). Kept, not deleted,
           so that a future gz-sim which implements the element starts honouring
           it - but do not count it as a safety layer today. -->
      <cmd_timeout>0.5</cmd_timeout>
    </plugin>

    <!-- JointStatePublisher plugin -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>

  </model>
</sdf>

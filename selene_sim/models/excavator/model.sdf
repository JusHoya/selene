<?xml version="1.0"?>
<sdf version="1.9">
  <model name="excavator">

    <!-- Base chassis -->
    <link name="base_link">
      <pose>0 0 0.14 0 0 0</pose>
      <inertial>
        <mass>132</mass>
        <inertia>
          <ixx>4.4</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>7.48</iyy>
          <iyz>0</iyz>
          <izz>11.0</izz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.8 0.6 0.2</size>
          </box>
        </geometry>
      </collision>
      <visual name="base_visual">
        <geometry>
          <box>
            <size>0.8 0.6 0.2</size>
          </box>
        </geometry>
        <material>
          <ambient>0.7 0.4 0.2 1</ambient>
          <diffuse>0.7 0.4 0.2 1</diffuse>
        </material>
      </visual>

      <!-- IMU sensor -->
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>imu</topic>
      </sensor>

      <!-- Depth camera -->
      <sensor name="depth_camera_sensor" type="depth_camera">
        <pose relative_to="base_link">0.4 0 0.05 0 0 0</pose>
        <update_rate>15</update_rate>
        <topic>depth_camera</topic>
        <camera>
          <horizontal_fov>1.5708</horizontal_fov>
          <image>
            <width>160</width>
            <height>120</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>20.0</far>
          </clip>
        </camera>
      </sensor>
    </link>

    <!-- Front left wheel -->
    <link name="front_left_wheel">
      <pose relative_to="base_link">0.3 0.35 0 -1.5708 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.0078</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0078</iyy>
          <iyz>0</iyz>
          <izz>0.0144</izz>
        </inertia>
      </inertial>
      <collision name="front_left_wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.6</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="front_left_wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <!-- Front right wheel -->
    <link name="front_right_wheel">
      <pose relative_to="base_link">0.3 -0.35 0 -1.5708 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.0078</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0078</iyy>
          <iyz>0</iyz>
          <izz>0.0144</izz>
        </inertia>
      </inertial>
      <collision name="front_right_wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.6</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="front_right_wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <!-- Mid left wheel — passive roller (not driven by DiffDrive plugin).
         Low lateral friction (mu2) so the wheel can slip sideways during
         skid-steer turns instead of dragging the chassis. Without this,
         the 6-wheel layout creates massive scrub and the excavator can
         barely turn. -->
    <link name="mid_left_wheel">
      <pose relative_to="base_link">0.0 0.35 0 -1.5708 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.0078</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0078</iyy>
          <iyz>0</iyz>
          <izz>0.0144</izz>
        </inertia>
      </inertial>
      <collision name="mid_left_wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.05</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="mid_left_wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="mid_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>mid_left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <!-- Mid right wheel — passive roller, see mid_left_wheel comment. -->
    <link name="mid_right_wheel">
      <pose relative_to="base_link">0.0 -0.35 0 -1.5708 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.0078</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0078</iyy>
          <iyz>0</iyz>
          <izz>0.0144</izz>
        </inertia>
      </inertial>
      <collision name="mid_right_wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.05</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="mid_right_wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="mid_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>mid_right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <!-- Rear left wheel -->
    <link name="rear_left_wheel">
      <pose relative_to="base_link">-0.3 0.35 0 -1.5708 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.0078</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0078</iyy>
          <iyz>0</iyz>
          <izz>0.0144</izz>
        </inertia>
      </inertial>
      <collision name="rear_left_wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.6</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="rear_left_wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <!-- Rear right wheel -->
    <link name="rear_right_wheel">
      <pose relative_to="base_link">-0.3 -0.35 0 -1.5708 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.0078</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0078</iyy>
          <iyz>0</iyz>
          <izz>0.0144</izz>
        </inertia>
      </inertial>
      <collision name="rear_right_wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.6</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="rear_right_wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <!-- Drill arm.
         TRAVEL POSITION. The arm is 0.4 m tall and hangs from base_link (which
         is at model z=0.14), so its pose here fixes how far the drill tip
         reaches below the vehicle. The wheels have radius 0.12 and their centres
         are level with base_link, so the WHEEL CONTACT LINE is at model z=+0.02.
         At the previous pose z=-0.1 the arm centre sat at model z=+0.04 and its
         tip at model z=-0.16, i.e. 0.18 m BELOW the wheels.
         MEASURED on a FLAT PLANE under lunar gravity - not on the terrain, on a
         plane, so this was purely a model defect and nothing to do with the
         heightmap: the excavator settled at model z=0.063114 with pitch
         -0.25732 rad (-14.7 deg), its driven wheel joints turned 38.754 rad
         (4.65 m of arc), odometry read 4.6505 m, and
         `gz model -m excavator_01 -p` reported displacement 0.0000 m. 100% slip.
         DERIVED from that pose, not separately measured: at pitch -0.25732 the
         drill box's leading bottom edge sits at world z=0.00000 (on the ground),
         the front wheel bottoms at 0.155 m and the rear wheel bottoms at 0.002 m.
         So the vehicle was high-centred on its own drill with four of its six
         wheels off the ground. Contact forces were not measured.
         Raising the arm to z=+0.16 puts the tip at model z=+0.10, i.e. 0.08 m
         ABOVE the wheel contact line, and the vehicle then settles level
         (pitch 0.00000, model z = surface - 0.02) and drives 4.8706 m in 12 s at
         0.4 m/s on the same plane. The <dynamics> added to drill_joint below is
         what keeps it there. -->
    <link name="drill_arm">
      <pose relative_to="base_link">0.4 0 0.16 0 0 0</pose>
      <inertial>
        <mass>5</mass>
        <inertia>
          <ixx>0.06933</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.06933</iyy>
          <iyz>0</iyz>
          <izz>0.00533</izz>
        </inertia>
      </inertial>
      <collision name="drill_arm_collision">
        <geometry>
          <box>
            <size>0.08 0.08 0.4</size>
          </box>
        </geometry>
      </collision>
      <visual name="drill_arm_visual">
        <geometry>
          <box>
            <size>0.08 0.08 0.4</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.85 1</ambient>
          <diffuse>0.8 0.8 0.85 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="drill_joint" type="prismatic">
      <parent>base_link</parent>
      <child>drill_arm</child>
      <axis>
        <xyz>0 0 -1</xyz>
        <limit>
          <lower>0</lower>
          <upper>0.3</upper>
        </limit>
        <!-- Nothing in SELENE actuates this joint in Gazebo: the drill is
             modelled in the HAL/skill layer (selene_agent/.../skills/excavate.py
             drives a HAL actuator, not a Gazebo joint), and there is no
             JointPositionController on this model. An unactuated prismatic joint
             pointing down is pulled to its lower stop by gravity, so without
             these two terms the arm deploys itself the moment the sim starts and
             drags on the ground. MEASURED, flat plane, lunar gravity, over 12 s
             of settling followed by 12 s of driving at 0.4 m/s:
               raised arm, no <dynamics>   -> drill_joint settles at +0.08000,
                                              which is exactly the travel needed
                                              to put the tip on the ground
               raised arm, with <dynamics> -> drill_joint settles at +0.01209 and
                                              stays there through 12 s of driving,
                                              leaving the tip 68 mm clear
             Both still drive (5.109 m vs 4.871 m in 12 s); the second keeps the
             drill off the ground, which is what a vehicle in transit should do.
             200 is not a tuned figure - it only has to hold a 5 kg arm against
             1.62 m/s^2, i.e. 8.1 N. An <effort> limit was tried too and made no
             difference (drill_joint settled at the same +0.01209), so it is not
             included. If a drill controller is ever added it must overcome these
             terms, or replace them with a proper actuator. -->
        <dynamics>
          <damping>200</damping>
          <friction>200</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- Hopper -->
    <link name="hopper">
      <pose relative_to="base_link">-0.3 0 0.2 0 0 0</pose>
      <inertial>
        <mass>3</mass>
        <inertia>
          <ixx>0.0325</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0325</iyy>
          <iyz>0</iyz>
          <izz>0.045</izz>
        </inertia>
      </inertial>
      <collision name="hopper_collision">
        <geometry>
          <box>
            <size>0.3 0.3 0.2</size>
          </box>
        </geometry>
      </collision>
      <visual name="hopper_visual">
        <geometry>
          <box>
            <size>0.3 0.3 0.2</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.6 0.2 1</ambient>
          <diffuse>0.6 0.6 0.2 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="hopper_joint" type="fixed">
      <parent>base_link</parent>
      <child>hopper</child>
    </joint>

    <!-- DiffDrive plugin — drives only the front and rear wheels.
         The mid wheels are intentionally NOT listed here so they remain
         passive rollers. A 6-wheel skid-steer with all wheels actively
         driven generates huge scrub at the mid wheels (which sit on the
         turn axis and can't translate sideways), making turns nearly
         impossible. Leaving the mids passive lets them spin freely
         during straight motion and slip during turns. -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.7</wheel_separation>
      <wheel_radius>0.12</wheel_radius>
      <max_linear_acceleration>0.3</max_linear_acceleration>
      <odom_publish_frequency>20</odom_publish_frequency>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <!-- Intended as a dead-man switch: zero the wheels if no cmd_vel arrives
           for 0.5 s. MEASURED: IT DOES NOTHING on the installed Gazebo. The
           string "cmd_timeout" does not occur in either installed DiffDrive
           build - `strings ... | grep -cx cmd_timeout` returns 0 for both
           /opt/ros/jazzy/opt/gz_sim_vendor/lib/gz-sim-8/plugins/libgz-sim8-diff-drive-system.so.8.11.0
           and /usr/lib/x86_64-linux-gnu/gz-sim-8/plugins/libgz-sim8-diff-drive-system.so.8.14.0
           (the same check returns 1 for "max_linear_acceleration", which the
           plugin does implement). gz-sim ignores unrecognised plugin elements
           silently, with no warning even at -v 4, so nothing flags this.
           There is therefore NO dead-man switch in the simulation: the only stop
           is the software one in AgentNode._stop_navigation(). Kept, not deleted,
           so that a future gz-sim which implements the element starts honouring
           it - but do not count it as a safety layer today. -->
      <cmd_timeout>0.5</cmd_timeout>
    </plugin>

    <!-- JointStatePublisher plugin -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>

    <!-- GROUND-TRUTH POSE, for the localisation stack the simulator stands in
         for. Publishes THE MODEL'S WORLD POSE on /model/<name>/pose as a
         gz.msgs.Pose_V with one entry; simulation.launch.py bridges it to
         /<robot_id>/pose_truth and world_odometry_node consumes it.

         WHY THIS EXISTS. DiffDrive above dead-reckons /model/<name>/odometry
         from wheel joint positions, and wheel odometry cannot detect its own
         failure: on 2026-07-31 a hauler pinned on the PSR crater wall reported
         126.7 m of travel at the commanded 0.395 m/s while its body moved
         6.6 cm, then declared arrival 241.577 m from the depot and unloaded.
         The only signal that can catch that is a second, independent position
         estimate. See selene_sim/selene_sim/localisation.py.

         WHY PosePublisher AND NOT OdometryPublisher. MEASURED here on gz-sim 8
         (2026-07-31): both report the true world pose, but OdometryPublisher's
         <odom_topic> is a literal with no model-name substitution, so two
         robots spawned from this same file would publish onto one topic.
         PosePublisher derives /model/<model name>/pose at runtime, which is
         what makes one <include>-able model file serve scout_01 and scout_02.

         WHY 20 Hz. The consumer compares path lengths over a 20 s window and
         decimates to 5 Hz before doing so; 20 Hz leaves margin for the
         freshness check without putting a 166 Hz pose stream on the DDS bus. -->
    <plugin filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>20</update_frequency>
    </plugin>

  </model>
</sdf>

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>selene_sim</name>
  <version>0.1.0</version>
  <description>Simulation environment for SELENE lunar ISRU fleet</description>
  <maintainer email="jushoya@selene.dev">JusHoya</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>selene_msgs</depend>
  <depend>ros2launch</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <!-- The ros_gz bridge renders gz.msgs.Pose_V as a TFMessage, which is how
       each robot's ground-truth world pose reaches world_odometry_node. -->
  <depend>tf2_msgs</depend>

  <!-- Runtime only: simulation.launch.py resolves
       FindPackageShare('selene_hal') to hand hopper_node and bin_load_node the
       RCDL that declares their capacity_kg and transfer_rate. No selene_sim
       source imports selene_hal, so pydantic stays out of the simulation
       runtime and these nodes remain testable without a colcon install. -->
  <exec_depend>selene_hal</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
